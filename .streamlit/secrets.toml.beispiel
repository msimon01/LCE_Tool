# Vorlage für Streamlit-Secrets (E08). Diese Datei enthält KEINE echten Werte.
#
# Online:  Streamlit Community Cloud → App → Settings → Secrets → Inhalt einfügen → Save
# Lokal:   Kopie dieser Datei als .streamlit/secrets.toml speichern (wird nicht auf GitHub
#          hochgeladen, siehe .gitignore)
#
# Ohne Secrets: kein Passwort, Kosten aus daten/kosten.csv.

[zugang]
passwort = "HIER-PASSWORT-EINTRAGEN"

[daten]
# Inhalt der Kosten-CSV (gleiches Format wie daten/kosten.csv: Trennzeichen ;, Dezimalpunkt).
# Zwischen die drei Anführungszeichen kopieren, erste Zeile = Spaltennamen.
kosten_csv = """
material_id;kosten_fix_eur_m2;kosten_je_cm_eur_m2;abbruch_fix_eur_m2;abbruch_je_cm_eur_m2;status;hinweis
stahlbeton;0;9.5;0;2.5;Quelle eintragen;Beispielzeile
"""
